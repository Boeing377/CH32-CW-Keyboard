#!/bin/sh
# Git post-commit hook - 每次提交后自动递增 BUILD 号
# 通过 Git Bash 执行，调用 PowerShell 完成实际工作

REPO_ROOT=$(git rev-parse --show-toplevel)
VERSION_FILE="$REPO_ROOT/version.txt"

if [ ! -f "$VERSION_FILE" ]; then
    echo "version.txt not found, skipping version bump."
    exit 0
fi

# 读取并递增 BUILD 号
OLD_VERSION=$(cat "$VERSION_FILE" | tr -d '\r\n')
MAJOR=$(echo "$OLD_VERSION" | cut -d. -f1)
MINOR=$(echo "$OLD_VERSION" | cut -d. -f2)
BUILD=$(echo "$OLD_VERSION" | cut -d. -f3)

if [ -z "$BUILD" ]; then
    echo "version.txt format invalid (expected MAJOR.MINOR.BUILD), skipping."
    exit 0
fi

NEW_BUILD=$((BUILD + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${NEW_BUILD}"
echo "$NEW_VERSION" > "$VERSION_FILE"

# 调用 PowerShell 生成 version.h
powershell -ExecutionPolicy Bypass -File "$REPO_ROOT/tools/gen_version.ps1" -ProjectRoot "$REPO_ROOT"

echo "Version bumped: $OLD_VERSION -> $NEW_VERSION"
echo "Hint: version.txt has been updated; include it in your next commit."
