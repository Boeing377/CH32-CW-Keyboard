#!/usr/bin/env pwsh
# Git post-commit hook - 每次提交后自动递增 BUILD 号
# 安装方式: 将此文件复制到 .git/hooks/post-commit，或运行:
#   git config core.hooksPath .githooks

$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$repoRoot = git rev-parse --show-toplevel
Set-Location $repoRoot

$versionFile = Join-Path $repoRoot "version.txt"

if (-not (Test-Path $versionFile)) {
    Write-Warning "version.txt not found, skipping version bump."
    exit 0
}

$version = Get-Content $versionFile -Raw
$version = $version.Trim()
$parts = $version -split '\.'

if ($parts.Count -lt 3) {
    Write-Warning "version.txt format invalid (expected MAJOR.MINOR.BUILD), skipping."
    exit 0
}

# 递增 BUILD 号
$build = [int]$parts[2] + 1
$newVersion = "$($parts[0]).$($parts[1]).$build"
Set-Content -Path $versionFile -Value $newVersion -NoNewline

# 生成 version.h
$genScript = Join-Path $repoRoot "tools\gen_version.ps1"
if (Test-Path $genScript) {
    & $genScript -ProjectRoot $repoRoot
}

Write-Host "Version bumped: $version -> $newVersion"
Write-Host "Hint: version.txt has been updated; include it in your next commit."
